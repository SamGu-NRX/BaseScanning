diff --git a/shared-assets/delivery/terraform-governance-pack/modules/github_actions_workload_identity/locals.tf b/shared-assets/delivery/terraform-governance-pack/modules/github_actions_workload_identity/locals.tf
--- a/shared-assets/delivery/terraform-governance-pack/modules/github_actions_workload_identity/locals.tf	2026-09-26 18:49:50
+++ b/shared-assets/delivery/terraform-governance-pack/modules/github_actions_workload_identity/locals.tf	2026-09-26 18:49:50
@@ -4,5 +4,14 @@
     "assertion.ref == \"${ref}\""
   ])
 
-  attribute_condition = "assertion.repository == \"${var.repository}\" && (${local.ref_condition})"
+  # Empty additional_attribute_conditions keeps the SMP string unchanged.
+  # Otherwise the original clause is parenthesized and OR-ed with the extras.
+  attribute_condition = (
+    length(var.additional_attribute_conditions) == 0
+    ? "assertion.repository == \"${var.repository}\" && (${local.ref_condition})"
+    : join(" || ", concat(
+      ["(assertion.repository == \"${var.repository}\" && (${local.ref_condition}))"],
+      var.additional_attribute_conditions,
+    ))
+  )
 }
diff --git a/shared-assets/delivery/terraform-governance-pack/modules/github_actions_workload_identity/variables.tf b/shared-assets/delivery/terraform-governance-pack/modules/github_actions_workload_identity/variables.tf
