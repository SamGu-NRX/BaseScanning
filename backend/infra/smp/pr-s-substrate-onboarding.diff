diff --git a/shared-assets/delivery/shared-baseline-substrate/product_state_access.tf b/shared-assets/delivery/shared-baseline-substrate/product_state_access.tf
new file mode 100644
--- /dev/null
+++ b/shared-assets/delivery/shared-baseline-substrate/product_state_access.tf
@@ -0,0 +1,10 @@
+resource "google_storage_bucket_iam_member" "product_state_object_admin" {
+  for_each = var.product_ci_state_access
+  bucket   = each.value.bucket
+  role     = "roles/storage.objectAdmin"
+  member   = each.value.member
+  condition {
+    title      = "tfstate-prefix-${each.key}"
+    expression = "resource.type == \"storage.googleapis.com/Bucket\" || resource.name.startsWith(\"projects/_/buckets/${each.value.bucket}/objects/${each.value.prefix}\")"
+  }
+}
