@@ -30,3 +30,9 @@
   type    = set(string)
   default = ["refs/heads/main"]
 }
+
+variable "additional_attribute_conditions" {
+  type        = list(string)
+  default     = []
+  description = "Extra attribute_condition clauses OR-ed with the repository and ref clause. Empty leaves the SMP condition unchanged."
+}
