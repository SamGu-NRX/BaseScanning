{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meter-models.v1.schema.json",
  "title": "Meter dimension table",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "table_version", "updated", "provenance_enum", "entries"],
  "properties": {
    "format": {"const": "meter-models/v1"},
    "table_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "provenance_enum": {
      "type": "array",
      "items": {"enum": ["datasheet", "standard", "caliper", "derived", "assumed", "missing"]}
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "manufacturer",
        "model_family",
        "type_codes",
        "us_market",
        "form",
        "cover_material",
        "cover_od_m",
        "cover_od_prov",
        "ring_od_m",
        "ring_od_prov",
        "base_od_m",
        "base_od_prov",
        "rim_offset_m",
        "rim_offset_prov",
        "depth_overall_m",
        "depth_overall_prov",
        "usable_for_scale",
        "source",
        "licence_note",
        "notes"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string"},
        "model_family": {"type": "string"},
        "type_codes": {"type": "array", "items": {"type": "string"}},
        "us_market": {"type": "boolean"},
        "form": {"type": ["string", "null"]},
        "cover_material": {"type": ["string", "null"]},
        "cover_od_m": {"type": ["number", "null"]},
        "cover_od_prov": {"enum": ["datasheet", "standard", "caliper", "derived", "assumed", "missing"]},
        "ring_od_m": {"type": ["number", "null"]},
        "ring_od_prov": {"enum": ["datasheet", "standard", "caliper", "derived", "assumed", "missing"]},
        "base_od_m": {"type": ["number", "null"]},
        "base_od_prov": {"enum": ["datasheet", "standard", "caliper", "derived", "assumed", "missing"]},
        "rim_offset_m": {"type": ["number", "null"]},
        "rim_offset_prov": {"enum": ["datasheet", "standard", "caliper", "derived", "assumed", "missing"]},
        "depth_overall_m": {"type": ["number", "null"]},
        "depth_overall_prov": {"enum": ["datasheet", "standard", "caliper", "derived", "assumed", "missing"]},
        "usable_for_scale": {"type": "boolean"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc"],
          "properties": {
            "doc": {"type": "string"},
            "url": {"type": "string"},
            "accessed": {"type": "string"},
            "pdf_sha256": {"type": "string"}
          }
        },
        "licence_note": {"type": "string"},
        "notes": {"type": "string"},
        "measured_by": {"type": "string"},
        "n_units": {"type": "integer", "minimum": 1},
        "measured_on": {"type": "string"},
        "readings_m": {"type": "array", "items": {"type": "number"}}
      }
    }
  }
}
