# Base-provided prompt material and anything else that must not reach GitHub.
private/

.venv/
__pycache__/
.env
.env.*
.terraform/
*.tfstate
*.tfstate.*
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
.DS_Store
runs/
.fixtures/

# data/ holds scripts and manifests only; frames, packets and videos live in the store or on disk.
data/houses/
data/packets/
data/frames/
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.heic
data/**/*.mp4
data/**/*.mov
data/**/*.npz
data/**/*.ply
data/**/*.bin

# Fetched tars, PLYs and extracts. Never commit them.
.fixtures/

# scripts/reads_gate.py --live --out. Holds real meter numbers (barcode payloads
# and reader answers). The default is /tmp/reads-gate, outside the repo. Never
# commit or upload this folder, including an in-repo copy such as reads-gate-live.
reads-gate*/

# Golden fixtures that are committed on purpose (coverage grids, mini-arkit stills).
!data/fixtures/**/*.jpg
!data/fixtures/**/*.jpeg
!data/fixtures/**/*.npz
!data/fixtures/**/*.bin

# Reconstruction outputs. Small JSON results under breadth outputs/ folders are committed.
*.ply
*.splat
# The build-plan reference set is the exception: ETH3D facade clouds for reviewers.
!media/colmap-facade/point-clouds/*.ply

# Terraform provider cache. Lock files stay committed.
.terraform/
