{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hss-registration-report/v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "mode",
    "status",
    "source_frame",
    "flow",
    "frames_given",
    "frames_registered",
    "registered_fraction",
    "frame_budget",
    "meter",
    "closeups",
    "actions",
    "prior",
    "arkit_fit",
    "matching",
    "quality",
    "timings_s",
    "params",
    "warnings"
  ],
  "properties": {
    "format": {"const": "hss-registration-report/v0"},
    "mode": {"enum": ["arkit_prior", "image_only", "arkit_fixed"]},
    "status": {"enum": ["ok", "fallback_arkit_fixed", "no_meter_model", "failed"]},
    "flow": {"enum": ["guided", "photo"]},
    "source_frame": {"type": "string"},
    "frames_given": {"type": "integer", "minimum": 0},
    "frames_registered": {"type": "integer", "minimum": 0},
    "registered_fraction": {"type": "number"},
    "frame_budget": {
      "type": "object",
      "required": ["sfm_max_frames", "mapper_frames", "registered_post", "arkit_carried"],
      "properties": {
        "sfm_max_frames": {"type": "integer"},
        "mapper_frames": {"type": "integer"},
        "registered_post": {"type": "integer"},
        "arkit_carried": {"type": "integer"}
      }
    },
    "meter": {
      "type": "object",
      "required": ["frames", "source", "in_primary"],
      "properties": {
        "source": {"enum": ["tap", "closeup_link", "detection", "override", "none"]},
        "in_primary": {"type": "boolean"}
      }
    },
    "closeups": {"type": "object"},
    "actions": {"type": "array", "items": {"type": "string"}},
    "prior": {"type": "object"},
    "arkit_fit": {
      "type": "object",
      "required": ["rms_m", "scale_pct"],
      "properties": {"rms_m": {"type": "number"}, "scale_pct": {"type": "number"}}
    },
    "matching": {"type": "object"},
    "quality": {"type": "object"},
    "timings_s": {"type": "object"},
    "params": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
