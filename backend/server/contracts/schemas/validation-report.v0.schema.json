{
  "$defs": {
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "level": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "pointer": {
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "keep_null": true,
          "title": "Value"
        }
      },
      "required": [
        "code",
        "level",
        "pointer",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "epochs": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Epochs"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Errors",
      "type": "array"
    },
    "files": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Files"
    },
    "filesHashed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Fileshashed"
    },
    "format": {
      "const": "hss-validation-report/v0",
      "default": "hss-validation-report/v0",
      "title": "Format",
      "type": "string"
    },
    "formatVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Formatversion"
    },
    "imagesDecodable": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Imagesdecodable"
    },
    "imagesUsable": {
      "title": "Imagesusable",
      "type": "boolean"
    },
    "keyframes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Keyframes"
    },
    "maxTapReplayError": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maxtapreplayerror"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "packetId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Packetid"
    },
    "stage": {
      "enum": [
        "manifest",
        "full"
      ],
      "title": "Stage",
      "type": "string"
    },
    "stills": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Stills"
    },
    "taps": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "number"
        }
      ],
      "default": 0,
      "title": "Taps"
    },
    "tier": {
      "anyOf": [
        {
          "enum": [
            "arkit_lidar",
            "arkit",
            "photo_only"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tier"
    },
    "timingsS": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timingss",
      "type": "object"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "stage",
    "ok",
    "errors",
    "warnings",
    "imagesUsable"
  ],
  "title": "Validation report v0",
  "type": "object"
}
