{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-hackathon/verdict.v0.schema.json",
  "title": "Verdict v0: one criteria path's answer for one scene",
  "description": "Per criterion pass / fail / unsure with reason, measured value, margin vs threshold, uncertainty and the views still needed. Contract: docs/scene-and-verdict-format.md. Lengths in feet (suffix _ft) because every threshold is written in feet; locations along the wall chain use the scene's s in meters (suffix _m) so they point back into the scene without conversion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "verdict_id",
    "scene",
    "evaluator",
    "site",
    "criteria",
    "views_needed"
  ],
  "properties": {
    "format": {
      "const": "base-verdict/v0"
    },
    "verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id",
        "site"
      ],
      "properties": {
        "scene_id": {
          "type": "string"
        },
        "site": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "producer_path": {
          "type": "string"
        },
        "data": {
          "enum": [
            "real",
            "synthetic",
            "hybrid"
          ]
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Track C path id, e.g. C1-rules-hs11, C2-volumetric, C3-vlm-judge."
        },
        "version": {
          "type": "string"
        },
        "rules_profile": {
          "type": "string",
          "description": "public, A, B, C or strictest."
        },
        "rules_sha256": {
          "type": "string"
        },
        "auto_approve": {
          "type": "boolean"
        },
        "runtime_s": {
          "type": "number",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "ground_incidence_deg": {
          "type": "number",
          "description": "Ground incidence limit of the scene bands this verdict was computed on (sensitivity runs)."
        },
        "ground_rule": {
          "type": "string",
          "description": "Ground rule variant of the scene bands this verdict was computed on (sensitivity runs)."
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pass",
            "manual_review",
            "reject"
          ],
          "description": "Placement decision for the site. needs-more-photos is expressed by manual_review plus a non-empty views_needed."
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chosen_candidate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "candidates": {
      "type": "array",
      "description": "Battery positions the evaluator considered. Runs of equal outcome along a wall may be one candidate with a start range.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "wall_id",
          "start_s_m",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "wall_id": {
            "type": "string"
          },
          "start_s_m": {
            "$ref": "#/$defs/span",
            "description": "Range of the battery's left-edge position s (a single start has start = end)."
          },
          "outcome": {
            "$ref": "#/$defs/outcome"
          },
          "failing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unsure": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "footprint_m": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "views_needed": {
      "type": "array",
      "description": "Views that would settle an UNSURE caused by unobserved space or an unread attribute. Empty for pass and reject. This list is the fog-of-war contract back to the iOS team.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "why",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "band",
              "past_end",
              "close_up",
              "confirm_attribute",
              "region"
            ]
          },
          "band": {
            "enum": [
              "wall",
              "ground",
              "overhead",
              "facing"
            ]
          },
          "wall_id": {
            "type": "string"
          },
          "s_m": {
            "$ref": "#/$defs/span"
          },
          "out_m": {
            "type": "number",
            "minimum": 0
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "target": {
            "type": "string",
            "description": "What to photograph, e.g. 'meter label close-up', 'ground 4.3 m out from the wall'."
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "unsure"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "outcome",
        "reason",
        "measured",
        "threshold"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Criterion id from the catalogue in docs/scene-and-verdict-format.md, e.g. opening_clearance, meter_identity."
        },
        "scope": {
          "enum": [
            "site",
            "candidate"
          ]
        },
        "candidate_id": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "unsure_cause": {
          "enum": [
            "margin",
            "unobserved",
            "grazing",
            "unknown_attribute",
            "rule_requires_review",
            "generated_only",
            "not_evaluated"
          ],
          "description": "Only for unsure. margin: measured inside the error band. unobserved: the deciding space was not seen (more photos fix it). grazing: it was seen only edge-on / at steep angles (a head-on photo fixes it). unknown_attribute: a fact the photos did not establish. rule_requires_review: the policy sends it to a person. generated_only: the only geometry there is generated. not_evaluated: the path cannot evaluate this criterion."
        },
        "reason": {
          "type": "string"
        },
        "measured": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value_ft",
                "plus_minus_ft",
                "coverage"
              ],
              "properties": {
                "value_ft": {
                  "type": "number"
                },
                "plus_minus_ft": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Uncertainty bound: the true value lies within this distance."
                },
                "subject": {
                  "type": "string",
                  "description": "What was measured to, e.g. 'objects[win-5] window'."
                },
                "element_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "coverage": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/coverage_evidence"
                  },
                  "description": "Coverage of every region the measurement depends on (both ends of a gap, the space between)."
                }
              }
            }
          ]
        },
        "fact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "clean",
            "coverage"
          ],
          "description": "Non-metric finding of a photo or close-up prompt (meter number, CL320, meter type, P12 flag). clean=false means the evidence was insufficient; such a criterion is never pass.",
          "properties": {
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "clean": {
              "type": "boolean"
            },
            "raw": {
              "type": "string",
              "description": "The prompt's own output value, e.g. yes / no / manual_review, cl320_unclear."
            },
            "coverage": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/coverage_evidence"
              }
            }
          }
        },
        "threshold": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value_ft",
                "comparison"
              ],
              "properties": {
                "value_ft": {
                  "type": "number"
                },
                "comparison": {
                  "enum": [
                    "at_least",
                    "at_most"
                  ]
                },
                "review_value_ft": {
                  "type": "number",
                  "description": "Review band line (e.g. confident reach 15 ft under a 20 ft max)."
                },
                "rule_key": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "margin_ft": {
          "type": [
            "number",
            "null"
          ],
          "description": "Signed distance from the measured value to the threshold, positive on the passing side."
        },
        "margin_over_uncertainty": {
          "type": [
            "number",
            "null"
          ],
          "description": "margin_ft / plus_minus_ft. PASS needs > 1 (C5 margin rule), FAIL needs < -1."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "element_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "views": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "coverage": {
              "enum": [
                "observed",
                "partial",
                "unobserved",
                "not_applicable"
              ]
            }
          }
        },
        "views_needed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids into the top-level views_needed."
        }
      }
    },
    "coverage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "status",
        "observed_share",
        "views_median",
        "best_incidence_deg",
        "rule"
      ],
      "description": "Coverage evidence attached to every measurement or query answer (contract section 3.1): was the queried region observed, by how many views, at what angle. Only status 'observed' can support pass or fail; grazing, partial, unobserved and generated force unsure.",
      "properties": {
        "region": {
          "type": "object",
          "additionalProperties": false,
          "description": "What was queried, in scene coordinates: wall_id + s_m + height_m = a wall-face patch; + out_m = the ground strip in front; + out_m + height_m = the free-space volume in front. element_ids / images for element-level queries (close-up reads).",
          "properties": {
            "wall_id": {
              "type": "string"
            },
            "s_m": {
              "$ref": "#/$defs/span"
            },
            "height_m": {
              "$ref": "#/$defs/span"
            },
            "out_m": {
              "$ref": "#/$defs/span"
            },
            "element_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "images": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string"
            }
          }
        },
        "status": {
          "enum": [
            "observed",
            "grazing",
            "partial",
            "unobserved",
            "generated"
          ],
          "description": "observed: >= observed_share of probes seen by >= min_views views within max_incidence_deg. grazing: seen, but only at steeper angles. partial: some seen well, the rest not seen. unobserved: mostly not seen. generated: mostly generated geometry."
        },
        "probes": {
          "type": "integer",
          "minimum": 0
        },
        "observed_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seen_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share seen by at least one view at any angle."
        },
        "views_min": {
          "type": "integer",
          "minimum": 0,
          "description": "Fewest well-angled views over the probes."
        },
        "views_median": {
          "type": "number",
          "minimum": 0
        },
        "best_incidence_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 90,
          "description": "Median over probes of the best (most head-on) viewing angle from the surface normal; null for free-space volumes."
        },
        "worst_best_incidence_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 90
        },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_views",
            "max_incidence_deg"
          ],
          "properties": {
            "min_views": {
              "type": "integer",
              "minimum": 1
            },
            "surface": {
              "enum": [
                "wall",
                "ground",
                "free"
              ]
            },
            "max_incidence_deg": {
              "type": [
                "number",
                "null"
              ],
              "description": "Limit applied to this region's surface (wall 75, ground 80 by default); null for free space."
            },
            "observed_share": {
              "type": "number"
            },
            "max_footprint_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "method": {
          "type": "string",
          "description": "e.g. evalharness.coverage.query_region, or the backend's own."
        },
        "sensitivity": {
          "type": "array",
          "description": "Ground regions: the grade under each ground rule variant (angle75, angle80, footprint3in).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_incidence_deg",
              "status"
            ],
            "properties": {
              "max_incidence_deg": {
                "type": "number"
              },
              "status": {
                "enum": [
                  "observed",
                  "grazing",
                  "partial",
                  "unobserved",
                  "generated"
                ]
              },
              "observed_share": {
                "type": "number"
              },
              "views_median": {
                "type": "number"
              },
              "rule_id": {
                "type": "string"
              },
              "max_footprint_m": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
