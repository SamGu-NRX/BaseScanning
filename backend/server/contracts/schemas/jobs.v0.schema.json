{
  "$defs": {
    "CaptureRecord": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "title": "Capture Id",
          "type": "string"
        },
        "created_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Created At",
          "type": "string"
        },
        "device_model": {
          "title": "Device Model",
          "type": "string"
        },
        "finalize_by": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Finalize By",
          "type": "string"
        },
        "flow": {
          "enum": [
            "guided",
            "photo"
          ],
          "title": "Flow",
          "type": "string"
        },
        "order_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Ref"
        },
        "owner_principal": {
          "title": "Owner Principal",
          "type": "string"
        },
        "packet_id": {
          "title": "Packet Id",
          "type": "string"
        },
        "packet_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Sha256"
        },
        "parent_capture_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Capture Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "status": {
          "enum": [
            "uploading",
            "awaiting_files",
            "processing",
            "needs_views",
            "complete",
            "manual_review",
            "failed",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "tier": {
          "enum": [
            "arkit_lidar",
            "arkit",
            "photo_only"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "packet_id",
        "status",
        "tier",
        "flow",
        "device_model",
        "owner_principal",
        "created_at",
        "finalize_by"
      ],
      "title": "CaptureRecord",
      "type": "object"
    },
    "CommittedFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bytes"
        },
        "generation": {
          "title": "Generation",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        },
        "path": {
          "pattern": "^(?!/)(?!.*\\.\\./).+$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "keyframe",
            "depth",
            "confidence",
            "features",
            "still",
            "stream",
            "truedepth",
            "mesh",
            "compat",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "role",
        "sha256",
        "bytes",
        "generation",
        "key"
      ],
      "title": "CommittedFile",
      "type": "object"
    },
    "EventRecord": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "At",
          "type": "string"
        },
        "capture_id": {
          "title": "Capture Id",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Seq"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "validate",
                "poses",
                "objects",
                "reads",
                "scale",
                "dense",
                "coverage",
                "scene",
                "objects_3d",
                "criteria",
                "result"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "type": {
          "enum": [
            "files_committed",
            "hint",
            "capture_check",
            "stage",
            "verdict_ready",
            "retake_request",
            "review_started",
            "review_completed",
            "failed",
            "confirmation"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "seq",
        "type",
        "at",
        "data"
      ],
      "title": "EventRecord",
      "type": "object"
    },
    "FileRecord": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bytes"
        },
        "capture_id": {
          "title": "Capture Id",
          "type": "string"
        },
        "committed_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed At"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "md5": {
          "title": "Md5",
          "type": "string"
        },
        "meta": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta"
        },
        "path": {
          "pattern": "^(?!/)(?!.*\\.\\./).+$",
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "keyframe",
            "depth",
            "confidence",
            "features",
            "still",
            "stream",
            "truedepth",
            "mesh",
            "compat",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "committed",
            "mismatch"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "path",
        "role",
        "bytes",
        "sha256",
        "md5",
        "content_type",
        "state"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "branch": {
          "enum": [
            "lidar",
            "image"
          ],
          "title": "Branch",
          "type": "string"
        },
        "capture_id": {
          "title": "Capture Id",
          "type": "string"
        },
        "created_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Created At",
          "type": "string"
        },
        "deadline_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Deadline At",
          "type": "string"
        },
        "degraded": {
          "items": {
            "enum": [
              "validate",
              "poses",
              "objects",
              "reads",
              "scale",
              "dense",
              "coverage",
              "scene",
              "objects_3d",
              "criteria",
              "result"
            ],
            "type": "string"
          },
          "title": "Degraded",
          "type": "array"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "flow": {
          "enum": [
            "guided",
            "photo"
          ],
          "title": "Flow",
          "type": "string"
        },
        "outcome_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Kind"
        },
        "packet_sha256": {
          "title": "Packet Sha256",
          "type": "string"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        },
        "profile_default": {
          "enum": [
            "A",
            "B",
            "C",
            "S"
          ],
          "title": "Profile Default",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "spend_usd": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Spend Usd",
          "type": "object"
        },
        "started_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "stale",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "tier": {
          "enum": [
            "arkit_lidar",
            "arkit",
            "photo_only"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "capture_id",
        "packet_sha256",
        "status",
        "branch",
        "flow",
        "tier",
        "profile_default",
        "created_at",
        "deadline_at",
        "artifacts"
      ],
      "title": "RunRecord",
      "type": "object"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Uri"
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "ge": 1,
          "title": "Attempt"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "failures": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "default": 0,
          "title": "Failures"
        },
        "finished_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "gpu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu"
        },
        "heartbeat": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "title": "Heartbeat",
          "type": "string"
        },
        "metrics": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        },
        "respawns": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "default": 0,
          "title": "Respawns"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "stage": {
          "enum": [
            "validate",
            "poses",
            "objects",
            "reads",
            "scale",
            "dense",
            "coverage",
            "scene",
            "objects_3d",
            "criteria",
            "result"
          ],
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "stale",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "substep": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substep"
        },
        "worker_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Call Id"
        }
      },
      "required": [
        "run_id",
        "stage",
        "status",
        "attempt",
        "heartbeat"
      ],
      "title": "StageRecord",
      "type": "object"
    },
    "StageResult": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "artifacts",
        "metrics",
        "warnings"
      ],
      "title": "StageResult",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/CaptureRecord"
    },
    {
      "$ref": "#/$defs/FileRecord"
    },
    {
      "$ref": "#/$defs/CommittedFile"
    },
    {
      "$ref": "#/$defs/RunRecord"
    },
    {
      "$ref": "#/$defs/StageRecord"
    },
    {
      "$ref": "#/$defs/EventRecord"
    },
    {
      "$ref": "#/$defs/StageResult"
    }
  ],
  "title": "Jobs v0"
}
