{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huntertcarver/house-scanning-server/schemas/scale-ext.v0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "rel_bound_95", "status", "estimates", "conflict"],
  "properties": {
    "source": {"enum": ["meter_model", "lidar", "arkit", "none"]},
    "model": {"type": ["string", "null"]},
    "scale_factor": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "rel_bound_95": {"type": "number", "minimum": 0},
    "status": {"enum": ["verified", "single_reference", "unverified"]},
    "estimates": {"type": "array"},
    "conflict": {"type": "boolean"},
    "origin_m": {"type": ["array", "null"]},
    "source_frame": {"type": ["string", "null"]},
    "rel_sd": {"type": ["number", "null"]},
    "confidence": {"type": ["string", "null"]},
    "reason": {"enum": ["scale_unresolved", "scale_conflict", null]},
    "reason_detail": {
      "enum": [
        "lidar_no_depth_files",
        "lidar_too_few_pairs",
        "meter_closeup_missing",
        "meter_closeup_unregistered",
        "meter_model_unread",
        "meter_identity_low_confidence",
        "meter_model_not_in_table",
        "meter_dimension_assumed",
        "meter_contour_ambiguous",
        "scale_reference_edge_not_found",
        "scale_reference_views_disagree",
        "scale_plane_fit_failed",
        "scale_conflict_objects",
        "arkit_gate_fail",
        "no_scale_source",
        null
      ]
    },
    "table_entry": {"type": ["string", "null"]},
    "table_version": {"type": ["string", "null"]},
    "arkit_gate": {"type": ["object", "null"]},
    "evidence": {"type": ["object", "null"]},
    "views_needed": {"type": "array"},
    "member_actions": {"type": "array"},
    "timings_s": {"type": ["object", "null"]}
  }
}
