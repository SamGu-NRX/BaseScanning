  "$id": "normalized-packet.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ext": {
      "properties": {
        "hss": {
          "additionalProperties": false,
          "properties": {
            "branch": {
              "enum": [
                "lidar",
                "image"
              ],
              "title": "Branch",
              "type": "string"
            },
            "captureCheck": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Capturecheck"
            },
            "depth": {
              "$ref": "#/$defs/DepthDerived"
            },
            "epochs": {
              "items": {
                "$ref": "#/$defs/EpochDerived"
              },
              "title": "Epochs",
              "type": "array"
            },
            "evidence": {
              "title": "Evidence",
              "type": "boolean"
            },
            "flow": {
              "enum": [
                "guided",
                "photo"
              ],
              "title": "Flow",
              "type": "string"
            },
            "flowSource": {
              "enum": [
                "capture_record",
                "inferred"
              ],
              "title": "Flowsource",
              "type": "string"
            },
            "format": {
              "const": "hss-normalized-packet/v0",
              "default": "hss-normalized-packet/v0",
              "title": "Format",
              "type": "string"
            },
            "isAmendment": {
              "title": "Isamendment",
              "type": "boolean"
            },
            "meterFrames": {
              "$ref": "#/$defs/MeterFrames"
            },
            "normalizedAt": {
              "title": "Normalizedat",
              "type": "string"
            },
            "notes": {
              "items": {
                "type": "string"
              },
              "title": "Notes",
              "type": "array"
            },
            "primaryEpoch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Primaryepoch"
            },
            "purposes": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": "Purposes",
              "type": "object"
            },
            "stats": {
              "$ref": "#/$defs/PacketStats"
            },
            "streams": {
              "additionalProperties": {
                "$ref": "#/$defs/StreamDerived"
              },
              "title": "Streams",
              "type": "object"
            },
            "validation": {
              "$ref": "#/$defs/ValidationSummary"
            },
            "validator": {
              "title": "Validator",
              "type": "string"
            }
          },
          "required": [
            "normalizedAt",
            "validator",
            "flow",
            "flowSource",
            "branch",
            "isAmendment",
            "evidence",
            "epochs",
            "depth",
            "purposes",
            "meterFrames",
            "streams",
            "stats",
            "notes",
            "validation"
          ],
          "title": "PacketDerived",
          "type": "object"
        }
      },
      "required": [
        "hss"
      ],
      "type": "object"
    }
  },
  "required": [
    "ext"
  ],
  "type": "object"
}
