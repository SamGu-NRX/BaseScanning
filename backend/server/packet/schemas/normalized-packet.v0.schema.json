{
  "$defs": {
    "DepthDerived": {
      "additionalProperties": false,
      "properties": {
        "confidenceShare": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidenceshare"
        },
        "coverage": {
          "title": "Coverage",
          "type": "number"
        },
        "keyframesWithDepth": {
          "title": "Keyframeswithdepth",
          "type": "integer"
        },
        "medianDepthM": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mediandepthm"
        }
      },
      "required": [
        "keyframesWithDepth",
        "coverage"
      ],
      "title": "DepthDerived",
      "type": "object"
    },
    "EpochDerived": {
      "additionalProperties": false,
      "properties": {
        "durationS": {
          "title": "Durations",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "keyframes": {
          "title": "Keyframes",
          "type": "integer"
        },
        "keyframesPerS": {
          "default": 0.0,
          "title": "Keyframespers",
          "type": "number"
        },
        "medianSpacingM": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medianspacingm"
        },
        "pathLengthM": {
          "title": "Pathlengthm",
          "type": "number"
        },
        "primary": {
          "title": "Primary",
          "type": "boolean"
        },
        "trackingHistogram": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Trackinghistogram",
          "type": "object"
        }
      },
      "required": [
        "id",
        "keyframes",
        "durationS",
        "pathLengthM",
        "trackingHistogram",
        "primary"
      ],
      "title": "EpochDerived",
      "type": "object"
    },
    "MeterFrames": {
      "additionalProperties": false,
      "properties": {
        "close": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Close"
        },
        "oblique": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oblique"
        },
        "tapKeyframe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tapkeyframe"
        }
      },
      "title": "MeterFrames",
      "type": "object"
    },
    "PacketStats": {
      "additionalProperties": false,
      "properties": {
        "blurredShare": {
          "default": 0.0,
          "title": "Blurredshare",
          "type": "number"
        },
        "durationS": {
          "title": "Durations",
          "type": "number"
        },
        "highIsoShare": {
          "default": 0.0,
          "title": "Highisoshare",
          "type": "number"
        },
        "imagesDecodable": {
          "title": "Imagesdecodable",
          "type": "integer"
        },
        "keyframes": {
          "title": "Keyframes",
          "type": "integer"
        },
        "keyframesPerS": {
          "title": "Keyframespers",
          "type": "number"
        },
        "medianSpacingM": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Medianspacingm"
        },
        "planes": {
          "title": "Planes",
          "type": "integer"
        },
        "stills": {
          "title": "Stills",
          "type": "integer"
        },
        "taps": {
          "title": "Taps",
          "type": "integer"
        }
