      "required": [
        "keyframes",
        "stills",
        "taps",
        "planes",
        "imagesDecodable",
        "durationS",
        "keyframesPerS"
      ],
      "title": "PacketStats",
      "type": "object"
    },
    "StreamDerived": {
      "additionalProperties": false,
      "properties": {
        "rateHzMeasured": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratehzmeasured"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "scaleToG": {
          "default": 1.0,
          "title": "Scaletog",
          "type": "number"
        },
        "tMax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmax"
        },
        "tMin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tmin"
        }
      },
      "required": [
        "rows"
      ],
      "title": "StreamDerived",
      "type": "object"
    },
    "ValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "reportPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reportpath"
        },
        "warnings": {
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "errors",
        "warnings"
      ],
      "title": "ValidationSummary",
      "type": "object"
    }
